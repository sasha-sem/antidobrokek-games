# Public site. Use :80 for local HTTP or quiz.example.com for automatic HTTPS.
DOMAIN=:80
HOST_SECRET=replace-with-at-least-16-random-characters
ADMIN_TOKEN=replace-with-another-random-token
DATABASE_URL=sqlite+aiosqlite:////data/quiz/db/dobrokek.sqlite3
DATA_DIR=/data/quiz
MAX_PLAYERS=5
MAX_PACK_SIZE_MB=500
MAX_VIDEO_SIZE_MB=50
MAX_VIDEO_DURATION_SECONDS=60
MAX_QUESTIONS=50
MIN_QUESTIONS=5
PRELOAD_TIMEOUT_SECONDS=15
REVEAL_DURATION_SECONDS=10
DEFAULT_QUESTION_GRACE_SECONDS=5
